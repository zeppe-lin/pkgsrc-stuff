# Description: Keyed-Hashing for Message Authentication
# URL:         https://metacpan.org/pod/Digest::HMAC
# Depends on:  perl

name=p5-digest-hmac
version=1.05
release=2
source=https://cpan.metacpan.org/authors/id/A/AR/ARODLAND/Digest-HMAC-$version.tar.gz

build() {
	cd Digest-HMAC-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR="$PKG" install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
