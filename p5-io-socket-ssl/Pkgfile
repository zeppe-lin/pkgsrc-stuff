# Description: Nearly transparent SSL encapsulation for IO::Socket::INET
# URL:         https://metacpan.org/pod/IO::Socket::SSL
# Depends on:  p5-mozilla-ca p5-net-ssleay

name=p5-io-socket-ssl
version=2.096
release=1
source=https://cpan.metacpan.org/authors/id/S/SU/SULLR/IO-Socket-SSL-$version.tar.gz

build() {
	cd IO-Socket-SSL-$version

	command -v finddepsdistmeta >/dev/null 2>&1 && finddepsdistmeta
	PERL_MM_USE_DEFAULT=1 perl -I. Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
