# Description: Data tables useful in parsing HTML
# URL:         https://metacpan.org/release/HTML-Tagset
# Depends on:  perl

name=p5-html-tagset
version=3.24
release=3
source=https://search.cpan.org/CPAN/authors/id/P/PE/PETDANCE/HTML-Tagset-$version.tar.gz

build() {
	cd HTML-Tagset-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	
	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
