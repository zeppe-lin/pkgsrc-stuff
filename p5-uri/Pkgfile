# Description: Perl Uniform Resource Identifiers Library
# URL:         https://metacpan.org/pod/URI
# Depends on:  p5-mime-base32 p5-test-fatal p5-test-needs p5-test-warnings

name=p5-uri
version=5.34
release=2
source=https://cpan.metacpan.org/authors/id/O/OA/OALDERS/URI-$version.tar.gz

build() {
	cd URI-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make install DESTDIR=$PKG

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
