# Description: Tool to generate AppImages from AppDirs
# URL:         https://github.com/AppImage/AppImageKit

name=appimagetool-appimage
version=1.9.1
release=1
source=AppImageTool-$version.AppImage::https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage

build() {
	local _destdir=$PKG/opt/AppImage

	mkdir -p $_destdir $PKG/usr/bin

	mv *.AppImage $_destdir/AppImageTool-$version.AppImage
	chmod +x $_destdir/AppImageTool-$version.AppImage

	ln -s ../../opt/AppImage/AppImageTool-$version.AppImage \
		$PKG/usr/bin/appimagetool
}
