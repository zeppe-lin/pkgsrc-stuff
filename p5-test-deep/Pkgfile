# Description: Extremely flexible deep comparison
# URL:         https://metacpan.org/pod/Test::Deep
# Depends on:  perl

name=p5-test-deep
version=1.205
release=2
source=https://cpan.metacpan.org/authors/id/R/RJ/RJBS/Test-Deep-$version.tar.gz

build() {
	cd Test-Deep-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
