# Description: Graph Plotting Module for Perl 5
# URL:         https://metacpan.org/pod/GD::Graph
# Depends on:  p5-gd-text

name=p5-gd-graph
version=1.56
release=3
source=https://cpan.metacpan.org/authors/id/B/BP/BPS/GDGraph-$version.tar.gz

build() {
	cd GDGraph-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
