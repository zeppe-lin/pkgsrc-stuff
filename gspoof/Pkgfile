# Description: Simple GTK/command line TCP/IP packet generator
# URL:         http://gspoof.sourceforge.net/
# Depends on:  gtk libnet ktsuss

# Maintainer notes on dependencies:
#   ktsuss: Needed to run with elevated privileges (enabled)

name=gspoof
version=3.2-0d8fb9e
release=4
source="https://github.com/embyte0/$name/archive/${version#*-}/$name-$version.tar.gz
	configure.ac.patch
	gfuncts.c.patch
	ginclude.h.patch
	gtk.c.patch
	interface.c.patch
	$name-gtk.sh
	$name-gtk.desktop"

build() {
	export CFLAGS="$CFLAGS -I/usr/include/cairo"

	cd gspoof-*

	patch -p0 -i $SRC/configure.ac.patch
	patch -p1 -i $SRC/gfuncts.c.patch
	patch -p1 -i $SRC/ginclude.h.patch
	patch -p1 -i $SRC/gtk.c.patch
	#patch -p0 -i $SRC/interface.c.patch

	#aclocal
	#autoconf -i
	./configure --prefix=/usr

	make V=1
	#make DESTDIR=$PKG install (broken)

	install -m 0755 -D gspoof $PKG/usr/bin/gspoof
	install -m 0755 -D $SRC/gspoof-gtk.sh $PKG/usr/bin/gspoof-gtk
	install -m 0644 -D $SRC/gspoof-gtk.desktop \
		$PKG/usr/share/applications/gspoof-gtk.desktop
	install -m 0644 -D pixmap/icon.png \
		$PKG/usr/share/pixmaps/gspoof.png
}
