# Description: Create, modify, and examine PDF files
# URL:         https://metacpan.org/pod/PDF::API2
# Depends on:  p5-font-ttf p5-test-exception p5-test-memory-cycle

name=p5-pdf-api2
version=2.048
release=2
source="https://cpan.metacpan.org/authors/id/S/SS/SSIMMS/PDF-API2-$version.tar.gz
	font-location.patch
	reproducible-resources.patch"

build() {
	cd PDF-API2-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	patch -Np1 -i $SRC/font-location.patch
	patch -Np1 -i $SRC/reproducible-resources.patch

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
