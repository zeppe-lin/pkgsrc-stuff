# Description: Test for warnings and the lack of them
# URL:         https://metacpan.org/pod/Test::Warnings
# Depends on:  perl

name=p5-test-warnings
version=0.038
release=2
source=https://cpan.metacpan.org/authors/id/E/ET/ETHER/Test-Warnings-$version.tar.gz

build() {
	cd Test-Warnings-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
