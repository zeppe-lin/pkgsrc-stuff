# Description: Build and install Perl modules
# URL:         https://metacpan.org/release/Module-Build
# Depends on:  p5-inc-latest

# Maintainer notes on dependencies:
#   p5-inc-latest: (enabled)

name=p5-module-build
version=0.42_35
release=2
source=https://cpan.metacpan.org/authors/id/L/LE/LEONT/Module-Build-$version.tar.gz

build() {
	cd Module-Build-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	yes n | PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
