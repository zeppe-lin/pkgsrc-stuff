# Description: Find memory cycles in objects
# URL:         https://metacpan.org/pod/Devel::Cycle
# Depends on:  perl

name=p5-devel-cycle
version=1.12
release=3
source=https://cpan.metacpan.org/authors/id/L/LD/LDS/Devel-Cycle-$version.tar.gz

build() {
	cd Devel-Cycle-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
