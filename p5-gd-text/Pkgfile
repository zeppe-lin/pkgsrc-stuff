# Description: Text utilities for use with GD
# URL:         https://metacpan.org/pod/GD::Text
# Depends on:  p5-gd

name=p5-gd-text
version=0.86
release=3
source=https://cpan.metacpan.org/authors/id/M/MV/MVERB/GDTextUtil-$version.tar.gz

build() {
	cd GDTextUtil-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
