# Description: Comma-separated values manipulator (using XS or PurePerl)
# URL:         https://metacpan.org/pod/Text::CSV
# Depends on:  perl

# Notes on dependencies:
#   p5-text-csv-xs: (enabled if installed)

name=p5-text-csv
version=2.06
release=2
source=https://cpan.metacpan.org/authors/id/I/IS/ISHIGAKI/Text-CSV-$version.tar.gz

build() {
	cd Text-CSV-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
