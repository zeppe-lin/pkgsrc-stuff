# Description: Utilities to test STDOUT and STDERR messages
# URL:         https://metacpan.org/pod/Test::Output
# Depends on:  p5-capture-tiny

name=p5-test-output
version=1.036
release=2
source=https://cpan.metacpan.org/authors/id/B/BR/BRIANDFOY/Test-Output-$version.tar.gz

build() {
	cd Test-Output-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
