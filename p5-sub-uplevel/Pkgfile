# Description: Apparently run a function in a higher stack frame
# URL:         https://metacpan.org/pod/Sub::Uplevel
# Depends on:  perl

name=p5-sub-uplevel
version=0.2800
release=3
source=https://cpan.metacpan.org/authors/id/D/DA/DAGOLDEN/Sub-Uplevel-$version.tar.gz

build() {
	cd Sub-Uplevel-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
