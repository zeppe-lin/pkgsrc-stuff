# Description: Read and write meta information
# URL:         https://metacpan.org/dist/Image-ExifTool
# Depends on:  perl

name=p5-image-exiftool
version=13.50
release=1
source=https://cpan.metacpan.org/authors/id/E/EX/EXIFTOOL/Image-ExifTool-$version.tar.gz

build() {
	cd Image-ExifTool-$version

	command -v finddepsdistmeta >/dev/null 2>&1 && finddepsdistmeta
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	mkdir -p $PKG/usr/share/$name
	cp -R fmt_files config_files arg_files $PKG/usr/share/$name/

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
			-o -name README \
		\) -delete \
		-o -type d -empty -delete
}
