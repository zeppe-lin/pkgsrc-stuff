# Description: WINE 4.0.x (stable) i386 AppImage
# URL:         https://github.com/mmtrt/WINE_AppImage
# Depends on:  fuse2

name=wine-4.0.x-i386-appimage
version=4.0.4
release=2
source=https://github.com/mmtrt/WINE_AppImage/releases/download/old-v4-i386/wine-stable-i386_$version-x86_64.AppImage

build() {
	_appimage=wine-stable-i386_$version-x86_64.AppImage
	_destdir=$PKG/opt/AppImage

	mkdir -p $_destdir
	mv $SRC/$_appimage $_destdir/
	chmod +x $_destdir/$_appimage
}
