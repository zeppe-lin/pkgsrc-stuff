# Description: Make sure you didn't emit any warnings while testing
# URL:         https://metacpan.org/pod/Test::NoWarnings
# Depends on:  perl

name=p5-test-nowarnings
version=1.06
release=3
source=https://cpan.metacpan.org/authors/id/H/HA/HAARG/Test-NoWarnings-$version.tar.gz

build() {
	cd Test-NoWarnings-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
