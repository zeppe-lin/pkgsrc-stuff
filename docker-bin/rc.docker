#!/bin/sh
#
# /etc/rc.d/docker: start/stop docker daemon
#

SSD=/sbin/start-stop-daemon
PROG=/usr/bin/dockerd
PID=/var/run/docker.pid
LOG=/var/log/docker.log
OPTS="-p $PID -G docker"

case $1 in
start)
	[ -f $LOG ] || install -o root -g docker -m 0640 /dev/null $LOG
	/usr/sbin/cgroupfs-mount
	$SSD --start --pidfile $PID --background --exec $PROG \
		-- $OPTS >> $LOG 2>&1
	;;
stop)
	$SSD --stop --retry 10 --pidfile $PID
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --pidfile $PID --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
