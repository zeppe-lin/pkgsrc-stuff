# Description: Perl module for TrueType Font hacking
# URL:         https://metacpan.org/pod/Font::TTF
# Depends on:  perl

name=p5-font-ttf
version=1.06
release=3
source=https://cpan.metacpan.org/authors/id/B/BH/BHALLISSY/Font-TTF-$version.tar.gz

build() {
	cd Font-TTF-$version

	if command -v finddepsdistmeta >/dev/null 2>&1; then
		finddepsdistmeta || :
	fi

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor

	make
	make DESTDIR=$PKG install

	# Remove junk and empty dirs
	find $PKG -depth \
		\( -type f -name perllocal.pod \
			-o -name '*.bs' \
			-o -name .packlist \
		\) -delete \
		-o -type d -empty -delete
}
